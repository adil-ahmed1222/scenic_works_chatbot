# ============================================================
# Scenic Works Chatbot — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or expose these keys in the frontend.
# ============================================================

# --- App ---
APP_ENV=development
APP_NAME=Scenic Works Chatbot
LOG_LEVEL=INFO

# Public URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,https://adroitiame.com,https://www.adroitiame.com,https://chat.adroitiame.com

# --- Groq ---
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024

# --- ElevenLabs ---
ELEVENLABS_API_KEY=replace_me
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_AR=onwK4e9ZLuTAKqWW03F9

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=tts-audio

# --- Embeddings (BAAI/bge-m3) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_PROVIDER=local
# Optional Hugging Face Inference API (query-time on small Railway instances)
HF_API_TOKEN=
HF_EMBEDDING_ENDPOINT=

# --- Scraper ---
CRAWL_BASE_URL=https://adroitiame.com
CRAWL_MAX_PAGES=500
CRAWL_MAX_DEPTH=6
CRAWL_DELAY_SECONDS=1.0
CRAWL_CONCURRENCY=3
CRAWL_TIMEOUT_SECONDS=45
CRAWL_USER_AGENT=ScenicWorksBot/1.0 (+https://adroitiame.com)

# --- RAG ---
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
CHAT_HISTORY_LIMIT=10

# --- Rate limiting ---
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_VOICE=10/minute
RATE_LIMIT_LEAD=8/minute
TRUST_PROXY=false

# Shared by FastAPI and the Next.js server proxy. Never expose as NEXT_PUBLIC_*.
WIDGET_API_SECRET=replace_with_long_random_secret
SESSION_SIGNING_KEY=replace_with_another_long_random_secret
RENDER_FRONTEND_URL=

# --- Frontend (public only — never put secrets here) ---
NEXT_PUBLIC_WIDGET_TITLE=Scenic Works Assistant
NEXT_PUBLIC_BRAND_NAME=Scenic Works
